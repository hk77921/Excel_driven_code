# Zerodha / KiteConnect Configuration
# =====================================
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to version control!

# EXECUTION MODE
# ==============
# Set to PAPER for simulated trading (no real money)
# Set to LIVE for real trading (CAUTION: real money!)
EXECUTION_MODE=PAPER

# ZERODHA CREDENTIALS (Required for LIVE mode)
# =============================================
# Get these from https://kite.zerodha.com/

# Your API key (from Zerodha dashboard)
KITE_API_KEY=your_api_key_here

# Your access token (obtained after login)
# You can get this from Kite's web interface or by logging in via API
KITE_ACCESS_TOKEN=your_access_token_here

# Your Zerodha User ID (email or user ID)
ZERODHA_USER_ID=your_user_id_here

# TRADING PARAMETERS (Optional - defaults in config/trading_config.yaml)
# =======================================================================

# Total capital for trading (in ₹)
TRADING_CAPITAL=5000

# Risk per trade (as decimal, 0.005 = 0.5%)
RISK_PER_TRADE=0.005

# Maximum daily loss limit (as decimal, 0.02 = 2%)
MAX_DAILY_LOSS_PCT=0.02

# LOGGING
# =======
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# EMAIL NOTIFICATIONS (Optional)
# =============================
# For alerts when trading stops or errors occur
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_EMAIL=recipient@example.com

# IMPORTANT NOTES:
# ================
# 1. For LIVE trading:
#    - Make sure you have tested thoroughly in PAPER mode first
#    - Keep your API key and access token SECRET
#    - Use a separate account for trading (recommended)
#    - Start with small capital to minimize risk
#
# 2. Getting KITE_ACCESS_TOKEN:
#    - Log in to https://kite.zerodha.com/
#    - Open developer console (F12)
#    - Go to Application tab → Cookies
#    - Find the session cookie or use API auth flow
#    - For production, use OAuth2 flow
#
# 3. Paper Trading:
#    - EXECUTION_MODE=PAPER uses yfinance for realistic prices
#    - No real API calls, no real money
#    - Perfect for testing strategies
#
# 4. If you get "Insufficient permissions" errors:
#    - Make sure your Zerodha account has API access enabled
#    - Check that your IP is whitelisted (if required)
#    - Ensure access token hasn't expired
